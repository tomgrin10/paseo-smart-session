{
  "name": "paseo-smart-session",
  "type": "module",
  "version": "1.2.2",
  "license": "MIT",
  "description": "Records Claude plan-usage history and lets a Paseo agent manage its own context.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tomgrin10/paseo-smart-session.git"
  },
  "homepage": "https://github.com/tomgrin10/paseo-smart-session#readme",
  "bugs": "https://github.com/tomgrin10/paseo-smart-session/issues",
  "author": "Tom Gringauz",
  "keywords": [
    "paseo",
    "paseo-plugin",
    "context",
    "monitoring",
    "productivity"
  ],
  "files": [
    "paseo-plugin.json",
    "index.client.tsx",
    "index.server.ts",
    "client/",
    "server/",
    "shared/",
    "hooks/",
    "mcp.mjs",
    "docs/"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types *.test.ts",
    "check": "node check-bundles.mjs && node check-gitinstall.mjs && node check-teardown.mjs && node check-mcp-resolve.mjs",
    "verify": "npm run typecheck && npm run test && npm run check"
  },
  "devDependencies": {
    "@babel/parser": "^8.0.4",
    "@getpaseo/client": "0.8.0-beta.1",
    "@getpaseo/plugin": "0.8.0-beta.1",
    "@getpaseo/protocol": "0.8.0-beta.1",
    "@tanstack/react-query": "^5.90.11",
    "@types/node": "^22.10.2",
    "@types/react": "~19.2.0",
    "esbuild": "^0.28.2",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  }
}
